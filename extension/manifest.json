{
  "manifest_version": 3,
  "name": "Smart Subtitles for Hulu",
  "version": "0.9.0",
  "description": "Bilingual AI subtitles for Hulu videos. Unofficial; not affiliated with Hulu.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Subtitles for Hulu",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hulu.com/*",
        "https://hulu.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.hulu.com/*",
        "https://hulu.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "core.js",
        "ttml.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
